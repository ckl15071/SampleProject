[
    {
        "key": "g d",
        "command": "editor.action.goToDefinition",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "g D",
        "command": "editor.action.goToDeclaration",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "g r",
        "command": "editor.action.revealDeclaration",
        "when": "editorTextFocus && !editorReadonly"
    }
